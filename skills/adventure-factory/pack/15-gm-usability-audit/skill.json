{
  "id": "15-gm-usability-audit",
  "title": "GM Usability Audit",
  "order": 17,
  "kind": "ai",
  "role": "gm_audit",
  "requires": [
    "story",
    "clues",
    "npcs",
    "locations",
    "encounters",
    "creatures",
    "items",
    "maps",
    "handouts"
  ],
  "produces": [
    "gm_audit"
  ],
  "version": "0.11.1",
  "output_schema": "output.schema.json",
  "context": {
    "story": [
      "plot_spine",
      "chapters",
      "advancement",
      "endings"
    ],
    "clues": [
      "clue_web",
      "critical_revelations"
    ],
    "npcs": [
      "npcs.*.name",
      "npcs.*.speech_style",
      "npcs.*.sample_lines",
      "npcs.*.reactions"
    ],
    "locations": [
      "locations.*.id",
      "locations.*.rooms"
    ],
    "encounters": [
      "encounters"
    ],
    "creatures": [
      "creatures.*.id",
      "creatures.*.stat_block"
    ],
    "items": [
      "items"
    ],
    "maps": [
      "maps.*.location_ref",
      "maps.*.rooms"
    ],
    "handouts": [
      "handouts"
    ]
  },
  "spec_fields": [
    "title",
    "concept",
    "system_family",
    "rules_profile",
    "level_band",
    "party_size",
    "play_time_hours",
    "tone",
    "constraints",
    "rules_specific",
    "combat_intensity",
    "entity_counts",
    "craft_references"
  ],
  "max_context_chars": 2000000,
  "validators": [
    "schema",
    "domain"
  ],
  "audit_sections": {
    "mode": "per_chapter",
    "note": "0.11.3: one pass per chapter (everything a GM runs in it, plus read-only creatures, items and NPCs it uses from other chapters) and one cross-section pass (advancement, endings, critical revelations, index). The quick reference is the union of all passes. Unchanged passes are reused by fingerprint.",
    "shared_read_only": [
      "story.plot_spine"
    ],
    "sectioned": [
      "story.chapters",
      "clues.clue_web",
      "npcs.npcs",
      "locations.locations",
      "encounters.encounters",
      "creatures.creatures",
      "items.items",
      "maps.maps",
      "handouts.handouts"
    ],
    "referenced": {
      "creatures.creatures": [
        "*"
      ],
      "items.items": [
        "id",
        "name",
        "rarity",
        "exact_rules_text"
      ],
      "npcs.npcs": [
        "*"
      ]
    }
  }
}
